{
  "name": "chrome-extension-template",
  "version": "1.0.0",
  "description": "A modern Chrome extension template with TypeScript and Vite",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,html,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "keywords": [
    "chrome-extension",
    "typescript",
    "vite"
  ],
  "author": "",
  "license": "MIT"
}
